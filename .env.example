# OpenAI-compatible API: chat, /embeddings and /rerank. On the hackathon platform these
# values are injected automatically; locally use any provider that serves the models below.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Web interface
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8000
